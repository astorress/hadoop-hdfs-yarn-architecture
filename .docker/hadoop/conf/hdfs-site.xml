<?xml version="1.0" encoding="UTF-8"?>
<!-- HDFS con alta disponibilidad: dos NameNodes (nn1, nn2), tres JournalNodes y failover automático con ZooKeeper. -->
<configuration>
  <!-- El nameservice agrupa a los dos NameNodes bajo un solo nombre -->
  <property>
    <name>dfs.nameservices</name>
    <value>lake</value>
  </property>
  <property>
    <name>dfs.ha.namenodes.lake</name>
    <value>nn1,nn2</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.lake.nn1</name>
    <value>nn1:8020</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.lake.nn2</name>
    <value>nn2:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.lake.nn1</name>
    <value>nn1:9870</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.lake.nn2</name>
    <value>nn2:9870</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>dfs.namenode.http-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <!-- El activo escribe cada cambio (edit) en la mayoría de los JournalNodes; el standby los lee y se mantiene al día -->
  <property>
    <name>dfs.namenode.shared.edits.dir</name>
    <value>qjournal://nn1:8485;nn2:8485;worker1:8485/lake</value>
  </property>
  <property>
    <name>dfs.journalnode.edits.dir</name>
    <value>/data/journal</value>
  </property>
  <!-- El standby lee los edits nuevos de los JournalNodes cada 5 s (por defecto, 60 s) -->
  <property>
    <name>dfs.ha.tail-edits.period</name>
    <value>5s</value>
  </property>
  <!-- El cliente prueba los NameNodes en orden hasta dar con el activo -->
  <property>
    <name>dfs.client.failover.proxy.provider.lake</name>
    <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
  </property>
  <property>
    <name>dfs.ha.automatic-failover.enabled</name>
    <value>true</value>
  </property>
  <!-- Fencing: aislar al activo anterior. Con Quorum Journal Manager, los JournalNodes ya rechazan sus escrituras -->
  <property>
    <name>dfs.ha.fencing.methods</name>
    <value>shell(/bin/true)</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///data/namenode</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///data/datanode</value>
  </property>
  <property>
    <name>dfs.replication</name>
    <value>3</value>
  </property>
  <property>
    <name>dfs.blocksize</name>
    <value>128m</value>
  </property>
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>
  <!-- DataNodes que deben salir del clúster (decommission). El laboratorio edita este archivo (lección 04) -->
  <property>
    <name>dfs.hosts.exclude</name>
    <value>/hadoop-admin/dfs.exclude</value>
  </property>
  <!-- Un DataNode se declara muerto tras 2 x 30 s + 10 x 3 s = 90 s sin latidos (por defecto, 10,5 minutos) -->
  <property>
    <name>dfs.namenode.heartbeat.recheck-interval</name>
    <value>30000</value>
  </property>
  <property>
    <name>dfs.namenode.safemode.extension</name>
    <value>5000</value>
  </property>
  <!-- El standby hace un checkpoint (fsimage nuevo) cada 2 minutos o cada 20.000 transacciones -->
  <property>
    <name>dfs.namenode.checkpoint.period</name>
    <value>120</value>
  </property>
  <property>
    <name>dfs.namenode.checkpoint.txns</name>
    <value>20000</value>
  </property>
  <!-- Re-replicación más rápida para ver la recuperación en segundos -->
  <property>
    <name>dfs.namenode.replication.work.multiplier.per.iteration</name>
    <value>10</value>
  </property>
  <property>
    <name>dfs.namenode.redundancy.interval.seconds</name>
    <value>1</value>
  </property>
</configuration>
