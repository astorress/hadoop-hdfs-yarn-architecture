                <mxCell id="datanodes-hdfs" edge="1" parent="arch-flow" source="workers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#336791;endArrow=block;dashed=1;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" target="hdfsdata" value="">
                    <mxGeometry relative="1" as="geometry">
